// ==UserScript==
// @name         Torn Revive Payment Tracker Faction Shared
// @namespace    https://torn.com
// @version      3.8.4
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives/main/Revives.user.js
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives/main/Revives.user.js
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function() {
    'use strict';

    const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxkcp47WfCfa5B5vE18DpssAvmZHCwYUfgSvApeE1GW852yBsJz-bFgQGACQQlgXFO8/exec';
    const STORAGE_KEY_APIKEY = 'trpt_api_keys';

    let sharedRevivesCache = null;
    let isFetchingRevives = false;

    // CSS styling properly wrapped as a template literal string
    const badgeCSS = `
        .trpt-badge {
            font-size: 11px !important;
            padding: 2px 6px !important;
            margin-left: 6px !important;
            margin-right: 6px !important;
            border-radius: 3px !important;
            font-weight: bold !important;
            color: #ffffff !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            cursor: pointer !important;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3) !important;
            z-index: 99999 !important;
            white-space: nowrap !important;
            height: 18px !important;
            vertical-align: middle !important;
        }
        .trpt-badge.paid { background-color: #28a745 !important; }
        .trpt-badge.unpaid { background-color: #dc3545 !important; }
    `;

    if (typeof GM_addStyle !== 'undefined') {
        GM_addStyle(badgeCSS);
    } else {
        const style = document.createElement('style');
        style.type = 'text/css';
        style.appendChild(document.createTextNode(badgeCSS));
        document.head.appendChild(style);
    }

    // Register configuration command in Tampermonkey menu
    GM_registerMenuCommand("TRPT: Set Faction API Key", configureApiKey);

    function getApiKey() {
        return GM_getValue(STORAGE_KEY_APIKEY, "");
    }

    function configureApiKey() {
        const currentKey = getApiKey();
        const newKey = prompt("Please enter the Faction Tracker API Key (Used to authorize with the Google Sheet):", currentKey);
        if (newKey !== null) {
            GM_setValue(STORAGE_KEY_APIKEY, newKey.trim());
            alert("API Key saved successfully! Refreshing data...");
            fetchReviveStatusFromSheet();
        }
    }

    // Fetch payment statuses globally from Google Sheets
    function fetchReviveStatusFromSheet() {
        if (isFetchingRevives) return;
        isFetchingRevives = true;
        
        const apiKey = getApiKey();
        if (!apiKey) {
            console.warn("TRPT: Faction API Key is missing. Click Tampermonkey icon -> TRPT: Set Faction API Key.");
            isFetchingRevives = false;
            return;
        }

        GM_xmlhttpRequest({
            method: "GET",
            url: `${GOOGLE_SCRIPT_URL}?apiKey=${encodeURIComponent(apiKey)}&action=getStatuses`,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data && data.success) {
                        sharedRevivesCache = data.revives;
                        processPageUi();
                    } else {
                        console.error("TRPT: Sheet returned an error:", data.error || "Unknown error");
                        if(data.error && data.error.includes("Unauthorized")) {
                            alert("TRPT Error: The API Key you entered does not match the server's key. Please update it in the Tampermonkey menu.");
                        }
                    }
                } catch (e) {
                    console.error("TRPT: Failed to parse spreadsheet response", e);
                }
            },
            onerror: function(err) {
                isFetchingRevives = false;
                console.error("TRPT: Network error fetching sheet statuses", err);
            }
        });
    }

    // Send a payload to toggle or update payment status on the sheet
    function updatePaymentStatusOnSheet(playerId, currentStatus) {
        const apiKey = getApiKey();
        if (!apiKey) return;
        const nextStatus = currentStatus === 'unpaid' ? 'paid' : 'unpaid';

        // Optimistic UI update
        if (sharedRevivesCache) {
            sharedRevivesCache[playerId] = nextStatus;
            processPageUi();
        }

        GM_xmlhttpRequest({
            method: "POST",
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            data: `apiKey=${encodeURIComponent(apiKey)}&action=updateStatus&playerId=${encodeURIComponent(playerId)}&status=${encodeURIComponent(nextStatus)}`,
            onload: function(response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (!data || !data.success) {
                        console.error("TRPT: Error sync updating status:", data.error);
                        // Revert cache on failure
                        if (sharedRevivesCache) {
                            sharedRevivesCache[playerId] = currentStatus;
                            processPageUi();
                        }
                        if(data.error && data.error.includes("Unauthorized")) {
                            alert("TRPT Sync Error: Invalid API key.");
                        }
                    }
                } catch(e) {
                    console.error("TRPT: Failed to parse sync response", e);
                }
            }
        });
    }

    // Injects or updates the badge next to a player element
    function injectBadge(element, playerId) {
        if (!sharedRevivesCache) return;
        const status = sharedRevivesCache[playerId];
        
        // Look for the badge directly AFTER the element, rather than inside it
        let existingBadge = null;
        if (element.nextElementSibling && element.nextElementSibling.classList.contains('trpt-badge')) {
            existingBadge = element.nextElementSibling;
        }

        if (!status) {
            if (existingBadge) existingBadge.remove();
            return;
        }

        // Update badge if it already exists
        if (existingBadge) {
            if (!existingBadge.classList.contains(status)) {
                existingBadge.className = `trpt-badge ${status}`;
                existingBadge.innerText = status.toUpperCase();
            }
            return;
        }

        // Create new badge
        const badge = document.createElement('span');
        badge.className = `trpt-badge ${status}`;
        badge.innerText = status.toUpperCase();
        badge.title = `Click to toggle tracking status for ID: ${playerId}`;

        badge.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            updatePaymentStatusOnSheet(playerId, status);
        });

        // INJECT AFTER the link so Torn's CSS doesn't hide it
        element.insertAdjacentElement('afterend', badge);
    }

    // Scans DOM elements across various pages to find Player IDs
    function processPageUi() {
        if (!sharedRevivesCache) return;

        // 1. Profile Pages (The main profile header)
        if (window.location.href.includes('profiles.php')) {
            const profileNameHeader = document.querySelector('.profile-wrapper .title .name');
            if (profileNameHeader) {
                const urlParams = new URLSearchParams(window.location.search);
                const playerId = urlParams.get('XID');
                if (playerId) {
                    injectBadge(profileNameHeader, playerId);
                }
            }
        }

        // 2. Hospital List & General User Links
        // Broadened the search to catch any link containing XID= (Torn has variations)
        const userLinks = document.querySelectorAll('a[href*="XID="]');
        userLinks.forEach(link => {
            const href = link.getAttribute('href');
            // Ensure we are grabbing the XID correctly
            const match = href.match(/XID=(\d+)/i);
            if (match && match[1]) {
                const playerId = match[1];
                // Check to ensure the link has text (ignores image-only links like attack icons)
                if (link.innerText && link.innerText.trim().length > 0) {
                    injectBadge(link, playerId);
                }
            }
        });
    }

    // Initialization and periodic sync
    fetchReviveStatusFromSheet();
    setInterval(fetchReviveStatusFromSheet, 180000); // 3 minutes

    // Monitor page updates for dynamic elements (Debounced for performance)
    let debounceTimer = null;
    const observer = new MutationObserver(() => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            processPageUi();
        }, 300);
    });
    observer.observe(document.body, { childList: true, subtree: true });

})();
