// ==UserScript==
// @name         Torn Revive Payment Tracker Faction Shared
// @namespace    https://torn.com
// @version      3.8.1
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @downloadURL  https://raw.githubusercontent.com/allbelowjd/Revives/main/Revives.user.js
// @updateURL    https://raw.githubusercontent.com/allbelowjd/Revives/main/Revives.user.js
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      api.torn.com
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript== 

(function() {
'use strict'; 

const GOOGLE_SCRIPT_URL = '[https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj_HsObFkWJZ1ch2Ydd5SR/exec](https://script.google.com/macros/s/AKfycbwrGdxSIxZupwZddypRhLTVYinjsRZ9ALT1FP5ad4ILLKfj_HsObFkWJZ1ch2Ydd5SR/exec)';
const STORAGE_KEY_APIKEY = 'trpt_api_keys';

let sharedRevivesCache = null;
let isFetchingRevives = false;

const badgeCSS = .trpt-badge { font-size: 11px !important; padding: 2px 6px !important; margin-left: 6px !important; margin-right: 6px !important; border-radius: 3px !important; font-weight: bold !important; color: #ffffff !important; display: inline-flex !important; align-items: center !important; justify-content: center !important; cursor: pointer !important; box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3) !important; z-index: 99999 !important; white-space: nowrap !important; height: 18px !important; } .trpt-badge.paid { background-color: #28a745 !important; } .trpt-badge.unpaid { background-color: #dc3545 !important; };

if (typeof GM_addStyle !== 'undefined') {
GM_addStyle(badgeCSS);
} else {
const style = document.createElement('style');
style.type = 'text/css';
style.appendChild(document.createTextNode(badgeCSS));
document.head.appendChild(style);
}

// Register configuration command in Tampermonkey menu
GM_registerMenuCommand("TRPT: Set Torn API Key", configureApiKey);

function getApiKey() {
return GM_getValue(STORAGE_KEY_APIKEY, "");
}

function configureApiKey() {
const currentKey = getApiKey();
const newKey = prompt("Please enter your Torn API Key (Requires Faction permissions):", currentKey);
if (newKey !== null) {
GM_setValue(STORAGE_KEY_APIKEY, newKey.trim());
alert("API Key saved successfully! Refreshing data...");
fetchReviveStatusFromSheet();
}
}

// Fetch payment statuses globally from Google Sheets
function fetchReviveStatusFromSheet() {
if (isFetchingRevives) return;
isFetchingRevives = true;
const apiKey = getApiKey();
if (!apiKey) {
    console.warn("TRPT: Torn API Key is missing. Click Tampermonkey icon -> TRPT: Set Torn API Key.");
    isFetchingRevives = false;
    return;
}

GM_xmlhttpRequest({
    method: "GET",
    url: `${GOOGLE_SCRIPT_URL}?apiKey=${apiKey}&action=getStatuses`,
    onload: function(response) {
        isFetchingRevives = false;
        try {
            const data = JSON.parse(response.responseText);
            if (data && data.success) {
                // Expected response: { success: true, revives: { "playerId": "paid", "playerId2": "unpaid" } }
                sharedRevivesCache = data.revives;
                processPageUi();
            } else {
                console.error("TRPT: Sheet returned an error:", data.error || "Unknown error");
            }
        } catch (e) {
            console.error("TRPT: Failed to parse spreadsheet response", e);
        }
    },
    onerror: function(err) {
        isFetchingRevives = false;
        console.error("TRPT: Network error fetching sheet statuses", err);
    }
});

}

// Send a payload to toggle or update payment status on the sheet
function updatePaymentStatusOnSheet(playerId, currentStatus) {
const apiKey = getApiKey();
if (!apiKey) return;
const nextStatus = currentStatus === 'unpaid' ? 'paid' : 'unpaid';

// Optimistic UI updates
if (sharedRevivesCache) {
    sharedRevivesCache[playerId] = nextStatus;
    processPageUi();
}

GM_xmlhttpRequest({
    method: "POST",
    url: GOOGLE_SCRIPT_URL,
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    data: `apiKey=${apiKey}&action=updateStatus&playerId=${playerId}&status=${nextStatus}`,
    onload: function(response) {
        try {
            const data = JSON.parse(response.responseText);
            if (!data || !data.success) {
                console.error("TRPT: Error sync updating status:", data.error);
                // Revert cache on failure
                if (sharedRevivesCache) {
                    sharedRevivesCache[playerId] = currentStatus;
                    processPageUi();
                }
            }
        } catch(e) {
            console.error("TRPT: Failed to parse sync response", e);
        }
    }
});

}

// Injects the badge next to a player name node
function injectBadge(element, playerId) {
if (!sharedRevivesCache || element.querySelector('.trpt-badge')) return;
const status = sharedRevivesCache[playerId];
if (!status) return; // Only display badges for tracked records

const badge = document.createElement('span');
badge.className = `trpt-badge ${status}`;
badge.innerText = status.toUpperCase();
badge.title = `Click to toggle tracking status for ID: ${playerId}`;

badge.addEventListener('click', function(e) {
    e.preventDefault();
    e.stopPropagation();
    updatePaymentStatusOnSheet(playerId, status);
});

element.appendChild(badge);

}

// Scans DOM elements across various pages to find Player IDs
function processPageUi() {
if (!sharedRevivesCache) return;
// 1. Profile Pages
if (window.location.href.includes('profiles.php')) {
    const profileNameHeader = document.querySelector('.profile-wrapper .title .name');
    if (profileNameHeader) {
        const urlParams = new URLSearchParams(window.location.search);
        const playerId = urlParams.get('XID');
        if (playerId) {
            injectBadge(profileNameHeader, playerId);
        }
    }
}

// 2. Hospital List & General User Lists
const userLinks = document.querySelectorAll('a[href*="profiles.php?XID="]');
userLinks.forEach(link => {
    const href = link.getAttribute('href');
    const match = href.match(/XID=(\d+)/);
    if (match && match[1]) {
        const playerId = match[1];
        
        // Avoid wrapping large images or layout blocks; apply only to descriptive text containers
        if (link.innerText && link.innerText.trim().length > 0) {
            injectBadge(link, playerId);
        }
    }
});

}

// Initialization and mutation safety loop
fetchReviveStatusFromSheet();
setInterval(fetchReviveStatusFromSheet, 60000); // Sync global cache every 60 seconds

// Monitor page updates for dynamic elements (AJAX-loaded elements like Hospital updates)
const observer = new MutationObserver(() => {
processPageUi();
});
observer.observe(document.body, { childList: true, subtree: true });

})();
