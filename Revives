// ==UserScript==
// @name         Torn Revive Payment Tracker Faction Shared
// @namespace    https://torn.com
// @version      3.9.2 (PDA Popup Fix)
// @description  Track revive payments globally across your faction using Google Sheets backend & auto payment matching
// @author       You
// @match        https://www.torn.com/*
// @run-at       document-idle
// @grant        GM_getValue
// @grant        GM_setValue
// @grant        GM_registerMenuCommand
// @grant        GM_xmlhttpRequest
// @grant        GM_addStyle
// @connect      script.google.com
// @connect      script.googleusercontent.com
// ==/UserScript==

(function() {
    'use strict';

    const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxkcp47WfCfa5B5vE18DpssAvmZHCwYUfgSvApeE1GW852yBsJz-bFgQGACQQlgXFO8/exec';
    const STORAGE_KEY_APIKEY = 'trpt_api_keys';

    let sharedRevivesCache = null;
    let isFetchingRevives = false;

    const badgeCSS = `
        .trpt-badge {
            font-size: 11px !important; padding: 2px 6px !important; margin-left: 6px !important;
            margin-right: 6px !important; border-radius: 3px !important; font-weight: bold !important;
            color: #ffffff !important; display: inline-flex !important; align-items: center !important;
            justify-content: center !important; cursor: pointer !important; box-shadow: 0 1px 2px rgba(0,0,0,0.3) !important;
            z-index: 99999 !important; white-space: nowrap !important; height: 18px !important; vertical-align: middle !important;
        }
        .trpt-badge.paid { background-color: #28a745 !important; }
        .trpt-badge.unpaid { background-color: #dc3545 !important; }
        
        #trpt-api-prompt {
            position: fixed; top: 30%; left: 50%; transform: translateX(-50%);
            background: #333; color: #fff; padding: 20px; z-index: 9999999;
            border: 2px solid #555; border-radius: 8px; width: 80%; max-width: 300px;
            text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.7); font-family: sans-serif;
        }
    `;

    if (typeof GM_addStyle !== 'undefined') {
        GM_addStyle(badgeCSS);
    } else {
        const style = document.createElement('style');
        style.type = 'text/css';
        style.appendChild(document.createTextNode(badgeCSS));
        document.head.appendChild(style);
    }

    // Still keep PC menu command
    GM_registerMenuCommand("TRPT: Set Faction API Key", showApiKeyUI);

    function getApiKey() {
        return GM_getValue(STORAGE_KEY_APIKEY, "");
    }

    // TornPDA Safe UI Prompt
    function showApiKeyUI(errorMessage = "") {
        if (document.getElementById('trpt-api-prompt')) return; // Don't open twice

        const container = document.createElement('div');
        container.id = 'trpt-api-prompt';
        
        container.innerHTML = `
            <h3 style="margin-top:0; color:white; font-size:16px;">TRPT Setup</h3>
            ${errorMessage ? `<p style="color:#ff6b6b; font-size:12px; margin-bottom:10px;">${errorMessage}</p>` : ''}
            <p style="font-size:13px; margin-bottom:10px; color:#ccc;">Enter Faction Tracker API Key:</p>
            <input type="text" id="trpt-api-input" style="width:90%; padding:8px; margin-bottom:15px; color:black; border-radius:4px; border:none;" value="${getApiKey()}"/>
            <br/>
            <button id="trpt-api-save" style="padding:8px 15px; background:#28a745; color:white; border:none; border-radius:4px; cursor:pointer; font-weight:bold;">Save & Run</button>
            <button id="trpt-api-cancel" style="padding:8px 15px; background:#666; color:white; border:none; border-radius:4px; cursor:pointer; margin-left:10px;">Cancel</button>
        `;

        document.body.appendChild(container);

        document.getElementById('trpt-api-save').addEventListener('click', () => {
            const newKey = document.getElementById('trpt-api-input').value.trim();
            if (newKey) {
                GM_setValue(STORAGE_KEY_APIKEY, newKey);
                document.body.removeChild(container);
                fetchReviveStatusFromSheet();
            }
        });

        document.getElementById('trpt-api-cancel').addEventListener('click', () => {
            document.body.removeChild(container);
        });
    }

    function fetchReviveStatusFromSheet() {
        if (isFetchingRevives) return;
        isFetchingRevives = true;
        
        const apiKey = getApiKey();
        if (!apiKey) {
            isFetchingRevives = false;
            showApiKeyUI();
            return;
        }

        GM_xmlhttpRequest({
            method: "GET",
            url: `${GOOGLE_SCRIPT_URL}?apiKey=${encodeURIComponent(apiKey)}&action=getStatuses`,
            onload: function(response) {
                isFetchingRevives = false;
                try {
                    const data = JSON.parse(response.responseText);
                    if (data && data.success) {
                        sharedRevivesCache = data.revives;
                        processPageUi();
                    } else {
                        if(data.error && data.error.includes("Unauthorized")) {
                            showApiKeyUI("Error: Invalid API Key. Please re-enter.");
                        }
                    }
                } catch (e) {
                    console.error("TRPT: Failed to parse response", e);
                }
            },
            onerror: function(err) {
                isFetchingRevives = false;
            }
        });
    }

    function updatePaymentStatusOnSheet(playerId, currentStatus) {
        const apiKey = getApiKey();
        if (!apiKey) return;
        const nextStatus = currentStatus === 'unpaid' ? 'paid' : 'unpaid';

        if (sharedRevivesCache) {
            sharedRevivesCache[playerId] = nextStatus;
            processPageUi();
        }

        GM_xmlhttpRequest({
            method: "POST",
            url: GOOGLE_SCRIPT_URL,
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            data: `apiKey=${encodeURIComponent(apiKey)}&action=updateStatus&playerId=${encodeURIComponent(playerId)}&status=${encodeURIComponent(nextStatus)}`,
            onload: function(response) {
                try {
                    const data = JSON.parse(response.responseText);
                    if (!data || !data.success) {
                        if (sharedRevivesCache) {
                            sharedRevivesCache[playerId] = currentStatus; // Revert on fail
                            processPageUi();
                        }
                        if(data.error && data.error.includes("Unauthorized")) {
                            showApiKeyUI("Sync Error: API Key invalid or expired.");
                        }
                    }
                } catch(e) {}
            }
        });
    }

    function injectBadge(element, playerId) {
        if (!sharedRevivesCache) return;
        const status = sharedRevivesCache[playerId];
        
        let existingBadge = null;
        if (element.nextElementSibling && element.nextElementSibling.classList.contains('trpt-badge')) {
            existingBadge = element.nextElementSibling;
        }

        if (!status) {
            if (existingBadge) existingBadge.remove();
            return;
        }

        if (existingBadge) {
            if (!existingBadge.classList.contains(status)) {
                existingBadge.className = `trpt-badge ${status}`;
                existingBadge.innerText = status.toUpperCase();
            }
            return;
        }

        const badge = document.createElement('span');
        badge.className = `trpt-badge ${status}`;
        badge.innerText = status.toUpperCase();
        
        badge.addEventListener('click', function(e) {
            e.preventDefault();
            e.stopPropagation();
            updatePaymentStatusOnSheet(playerId, status);
        });

        element.insertAdjacentElement('afterend', badge);
    }

    function processPageUi() {
        if (!sharedRevivesCache) return;

        if (window.location.href.includes('profiles.php')) {
            const profileNameHeader = document.querySelector('.profile-wrapper .title .name');
            if (profileNameHeader) {
                const urlParams = new URLSearchParams(window.location.search);
                const playerId = urlParams.get('XID') || urlParams.get('xid');
                if (playerId) {
                    injectBadge(profileNameHeader, playerId);
                }
            }
        }

        const userLinks = document.querySelectorAll('a[href*="XID=" i]');
        userLinks.forEach(link => {
            const href = link.getAttribute('href');
            const match = href.match(/XID=(\d+)/i);
            if (match && match[1]) {
                const playerId = match[1];
                if (link.innerText && link.innerText.trim().length > 0) {
                    injectBadge(link, playerId);
                }
            }
        });
    }

    fetchReviveStatusFromSheet();
    setInterval(fetchReviveStatusFromSheet, 180000);

    let debounceTimer = null;
    const observer = new MutationObserver(() => {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
            processPageUi();
        }, 300);
    });
    observer.observe(document.body, { childList: true, subtree: true });

})();
